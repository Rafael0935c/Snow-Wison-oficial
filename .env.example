# Copie para .env.local (desenvolvimento) ou cadastre na Cloudflare.
# Todas são opcionais: sem elas, valem os padrões de lib/siteConfig.ts e
# lib/sentryConfig.ts, que já são os valores de produção.
#
# Tudo que começa com NEXT_PUBLIC_ vai parar no JavaScript do navegador,
# visível para qualquer visitante. NUNCA coloque segredo com esse prefixo.

# WhatsApp da escola, formato internacional, só dígitos.
NEXT_PUBLIC_WHATSAPP=5521980999435

# Domínio oficial, sem barra no fim (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://snowwison.com

# DSN do Sentry (público por natureza: só permite ENVIAR erros).
NEXT_PUBLIC_SENTRY_DSN=
